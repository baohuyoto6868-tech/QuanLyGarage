rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : null;
    }

    function hasRole(role) {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper for validation
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if (isSignedIn() && userId == request.auth.uid && !exists(/databases/$(database)/documents/users/$(userId))) || isAdmin();
      allow update: if isAdmin() || (isSignedIn() && userId == request.auth.uid && incoming().role == existing().role);
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Vehicles
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Products
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (hasRole('admin') || hasRole('manager'));
    }

    // Inventory Logs
    match /inventoryLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        existing().status != 'completed' && existing().status != 'cancelled'
      );
      
      match /items/{itemId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // System Logs
    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
    }
  }
}
